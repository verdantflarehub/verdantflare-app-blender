# Immutable build input from the verified Desktop rehearsal. Deployment image
# references use this application's own immutable SemVer tags.
FROM registry.cn-qingdao.aliyuncs.com/wod/beagle-wind-vnc@sha256:ee0a990677694e9919cbedaae227f246867b5e183d1caa48b2fdc09d37e63305
LABEL org.opencontainers.image.title="VerdantFlare Blender worker" \
      org.opencontainers.image.version="0.1.6" \
      org.opencontainers.image.source="https://github.com/verdantflarehub/verdantflare-app-blender" \
      blender.version="4.5.14"
USER root
COPY runtime/ /opt/beagle/blender-mcp/
COPY runtime/upstream.lock /etc/beagle-wind-vnc/kde6-blender-mcp.lock
RUN chmod +x /opt/beagle/blender-mcp/*.sh && \
    chown -R 1000:1000 /opt/beagle/blender-mcp && \
    test -x /opt/blender/blender
USER 1000:1000
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["/opt/beagle/blender-mcp/blender-mcp-entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/opt/beagle/blender-mcp/supervisord-blender.conf"]
